#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// / {
//     chosen { zmk,matrix_transform = &default_transform; };
// };

/ {
    /* input config for mouse move mode */

    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <0>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <2>;

        // bindings = <&ib_toggle_layer 7>;
    };

    /* input config for snipe mode */

    trackball_snipe_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <3>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <4>;
    };

    /* input config for mouse scroll mode */

    trackball_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <2>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_HWHEEL>;
        y-input-code = <INPUT_REL_WHEEL>;
        y-invert;
        bindings = <&ib_wheel_scaler 1 14>;
    };

    /* define a resolution down scaler only for INPUT_REL_WHEEL */

    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };

    /* adjust cooldown waiting period for mouse key layer after activated */

    ib_toggle_layer: ib_toggle_layer {
        compatible = "zmk,input-behavior-tog-layer";
        #binding-cells = <1>;
        time-to-live-ms = <750>;
    };

    // #define BASE      0
    // #define NAV_EDIT  1
    // #define SCROLL    2
    // #define SNIPER    3
    // #define NUM_SYM   4
    // #define SHORTCUTS 5
    // #define SYSTEM    6

    combos {
        compatible = "zmk,combos";

        CAPZ {
            bindings = <&kp CAPSLOCK>;
            key-positions = <12 13>;
        };

        CAPZ_WORD {
            bindings = <&caps_word>;
            key-positions = <16 19>;
        };

    };

    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41 36 37 38>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp ESCAPE        &kp N1               &kp N2           &kp N3           &kp N4             &kp N5       &kp N6     &kp N7              &kp N8           &kp N9            &kp N0                &kp MINUS
&kp TAB           &kp Q               &kp W            &kp F            &kp P              &kp B        &kp J      &kp L               &kp U            &kp Z             &kp SEMICOLON      &kp LEFT_BRACKET
&kp LEFT_SHIFT    &hml LEFT_CONTROL A  &hml LEFT_ALT R  &hml LEFT_GUI S  &hml LEFT_SHIFT T  &kp G        &kp M      &hmr RIGHT_SHIFT N  &hmr LEFT_GUI E  &hmr RIGHT_ALT I  &hmr RIGHT_CONTROL O  &kp APOSTROPHE
&kp LEFT_CONTROL  &lt 2 X              &kp C            &kp D            &kp V              &kp Y        &kp K      &kp H               &kp COMMA     &kp DOT        &lt 2 SLASH        &kp RIGHT_BRACKET
                                                        &lt 4 LEFT_GUI   &kp SPACE          &lt 1 TAB    &mo 5      &kp BACKSPACE
                                                                         &mkp MB1           &mkp MB2     &kp ENTER
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_edit_layer {
            label = "NAV_EDIT";
            bindings = <
&kp F1  &kp F2        &kp F3      &kp F4            &kp F5      &kp F6       &kp F7        &kp F8          &kp F9          &kp F10          &kp F11       &kp F12
&trans  &kp ESCAPE    &msc MOVE_UP  &mkp MB4      &mkp MB5           &mmv MOVE_UP  &kp PAGE_UP   &kp HOME        &kp UP_ARROW    &kp END          &lt 4 DELETE    &lt 5 INSERT
&trans  &kp LEFT_ALT  &msc MOVE_DOWN  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &mmv MOVE_DOWN  &kp PAGE_DOWN &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp BACKSPACE  &lt 6 K_APP
&trans  &kp LC(X)     &kp LC(C)   &kp LC(D)         &kp LC(V)          &kp LC(Z)    &trans        &mkp MCLK       &mmv MOVE_LEFT  &mmv MOVE_RIGHT  &kp LC(F)        &trans
                                    &trans           &kp ENTER    &trans       &trans        &trans
                                                      &trans       &trans       &kp PRINTSCREEN
            >;
        };

        scroll_layer {
            bindings = <
&trans  &trans          &trans            &trans        &trans        &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans          &trans            &trans        &trans        &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans          &trans            &trans        &trans        &trans    &trans     &trans     &trans  &trans  &trans  &trans
                                          &trans        &trans        &trans    &mkp RCLK  &mkp LCLK
                                                        &trans        &trans    &trans
            >;

            label = "SCROLL";
        };

        sniper_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;

            label = "SNIPER";
        };

        num_sym_layer {
            label = "NUM_SYM";
            bindings = <
&kp CARET  &kp EXCL  &kp AT  &kp HASH      &kp DLLR     &kp PRCNT   &kp AMPS  &kp KP_N7       &kp KP_N8       &kp KP_N9       &kp KP_MULTIPLY  &kp KP_MINUS
&kp EQUAL  &kp LPAR  &kp RPAR  &kp LBKT     &kp RBKT     &kp LBRC    &kp RBRC  &kp KP_N4       &kp KP_N5       &kp KP_N6       &kp KP_PLUS      &kp QMARK
&kp QMARK  &kp EQUAL  &kp PLUS  &kp MINUS    &kp UNDER    &kp FSLH    &kp BSLH  &kp KP_N1       &kp KP_N2       &kp KP_N3       &kp KP_ENTER     &kp COLON
&kp STAR   &kp LT    &kp GT    &kp PIPE      &kp SQT      &kp DQT     &kp GRAVE &kp KP_N0       &kp KP_N0       &kp KP_DOT      &kp KP_DIVIDE    &kp SEMI
                                      &trans        &kp SPACE      &trans         &trans         &trans
                                                    &trans         &trans         &kp KP_ENTER
            >;
        };

        shortcuts_layer {
            label = "SHORTCUTS";
            bindings = <
&trans  &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
&trans  &kp LC(Q) &kp LC(W) &kp LC(F) &kp LC(P) &kp LC(B) &kp LC(J) &kp LC(L) &kp LC(U) &kp LC(Z) &trans    &trans
&trans  &kp LC(A) &kp LC(R) &kp LC(S) &kp LC(T) &kp LC(G) &kp LC(M) &kp LC(N) &kp LC(E) &kp LC(I) &kp LC(O) &trans
&trans  &kp LC(X) &kp LC(C) &kp LC(D) &kp LC(V) &kp LC(Y) &kp LC(K) &kp LC(H) &trans    &trans    &trans    &trans
                                &trans  &kp ENTER  &trans    &trans    &trans
                                        &trans    &trans    &trans
            >;
        };

        system_layer {
            label = "SYSTEM";
            bindings = <
&trans             &trans        &trans        &trans        &trans            &trans        &trans           &trans           &trans           &trans           &trans           &trans
&bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans           &trans           &trans           &trans           &trans           &trans
&trans             &kp C_SLEEP   &kp C_AL_COFFEE  &soft_off   &bootloader   &ext_power EP_TOG  &kp C_PREV    &kp C_PLAY_PAUSE &kp C_NEXT       &kp C_VOL_DN     &kp C_VOL_UP     &kp C_MUTE
&trans             &trans        &trans        &trans        &trans        &trans          &trans           &trans           &trans           &trans           &trans           &trans
                                               &trans        &trans        &trans          &trans           &trans
                                                             &trans        &trans          &trans
            >;
        };
    };
};
