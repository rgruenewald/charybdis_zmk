#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_de_german.h"

/*
 * Editor mirror keymap
 * -------------------
 * This file prioritizes keymap-editor readability.
 * Hardware-specific corrections are made in `charybdis.keymap`.
 */
/* Layer IDs (keep stable; referenced by listeners and toggles) */

#define BASE    0
#define NAV     1
#define SYM     2
#define NUM     3
#define MEDIA   4
#define MOUSE   5
#define SCROLL  6
#define FUN     7
#define UML     8

/ {
    /* Trackball pointer on normal layers */

    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <BASE NAV NUM MEDIA MOUSE>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <2>;
    };

    /* Trackball scroll only when SCROLL layer is active */

    trackball_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <SCROLL>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_HWHEEL>;
        y-input-code = <INPUT_REL_WHEEL>;
        y-invert;
        bindings = <&ib_wheel_scaler 1 14>;
    };

    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };

    behaviors {
        /* Home-row mod hold-tap behaviors with opposite-hand hold triggers */

        hm_l: hm_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <170>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52 54 55>;
            hold-trigger-on-release;
        };

        hm_r: hm_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <170>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 53>;
            hold-trigger-on-release;
        };

        /* Thumb layer-tap with quick-tap repeat: tap, then quick re-press-and-hold repeats Backspace instead of activating SYM. */

        bspc_sym: bspc_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "BSPC_SYM";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        /* Thumb layer-tap with quick-tap repeat for Space before NAV hold. */

        spc_nav: spc_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "SPC_NAV";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        /* Thumb layer-tap with quick-tap repeat for Enter before NUM hold. */

        ent_num: ent_num {
            compatible = "zmk,behavior-hold-tap";
            label = "ENT_NUM";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        /* Thumb layer-tap with quick-tap repeat for Delete before FUN hold. */

        del_fun: del_fun {
            compatible = "zmk,behavior-hold-tap";
            label = "DEL_FUN";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        /* Mouse button hold-tap: tap right click, hold scroll layer. */

        rclk_scroll: rclk_scroll {
            compatible = "zmk,behavior-hold-tap";
            label = "RCLK_SCR";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            flavor = "balanced";
            bindings = <&mo>, <&mkp>;
        };

        /* NUM layer shifted dual-bindings (tap number, hold shift => symbol) */

        n7s: n7s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp AMPS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n8s: n8s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp STAR>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n9s: n9s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp LPAR>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n4s: n4s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N4>, <&kp DLLR>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n5s: n5s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N5>, <&kp PRCNT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n6s: n6s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp CARET>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n1s: n1s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp EXCL>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n2s: n2s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp AT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n3s: n3s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N3>, <&kp HASH>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n0s: n0s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp RPAR>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nds: nds {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp GT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nms: nms {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp UNDER>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nlb: nlb {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp LBRC>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nsc: nsc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp COLON>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ngr: ngr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp GRAVE>, <&kp TILDE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nrb: nrb {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&kp RBRC>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        neq: neq {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp PLUS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nbs: nbs {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSLH>, <&kp PIPE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sls: sls {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp BSLH>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bslh_sls: bslh_sls {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSLH>, <&kp SLASH>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp N1      &kp N2            &kp N3            &kp N4                &kp N5              &kp N6                      &kp N7               &kp N8                   &kp N9                 &kp N0             &kp SINGLE_QUOTE   &kp PLUS
&kp ESCAPE  &kp Q             &kp K             &kp O                 &kp U               &kp Y                       &kp V                &kp D                    &kp C                  &kp L              &kp F              &kp J
&mo 8       &hm_l LEFT_GUI H  &hm_l LEFT_ALT A  &hm_l LEFT_CONTROL E  &hm_l LEFT_SHIFT I  &kp COMMA                   &kp G                &hm_r RIGHT_SHIFT T      &hm_r RIGHT_CONTROL R  &hm_r RIGHT_ALT N  &hm_r RIGHT_GUI S  &mo UML
&sls        &mkp MCLK         &kp Z             &kp DQT               &kp DOT             &kp X                       &kp B                &kp P                    &kp M                  &kp W              &kp RIGHT_SHIFT    &kp HASH
                                                &lt MOUSE TAB         &spc_nav NAV SPACE  &lt MEDIA ESCAPE            &ent_num NUM ENTER   &bspc_sym SYM BACKSPACE
                                                                      &mkp LCLK           &rclk_scroll SCROLL RCLK    &del_fun FUN DELETE
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            label = "NAV";
            bindings = <
&none   &none             &none            &none            &none                &none                  &none          &none            &none           &none            &none            &none
&none   &sk LEFT_GUI      &sk LEFT_ALT     &sk LEFT_CONTROL &sk LEFT_SHIFT       &none                  &kp LC(Z)      &kp LS(INSERT)   &kp LC(INSERT)  &kp LC(X)        &kp LC(Y)        &none
&none         &kp LEFT_GUI  &kp LEFT_ALT     &kp LEFT_CONTROL &kp LEFT_SHIFT       &none                  &kp CAPSLOCK   &kp LEFT_ARROW   &kp DOWN_ARROW  &kp UP_ARROW     &kp RIGHT_ARROW  &none
&none   &none             &none            &none            &none                &none                  &kp INSERT     &kp HOME         &kp PAGE_DOWN   &kp PAGE_UP      &kp END          &none
                                   &trans            &trans           &trans               &trans           &trans
                                                     &trans           &trans           &trans
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
&none  &none      &none     &none      &none      &none       &none   &none           &none             &none         &none         &none
&none  &kp LBRC   &kp AMPS  &kp STAR   &kp LPAR   &kp RBRC    &none   &none           &none             &none         &none         &none
&none  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS    &none   &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &none
&none  &kp LBKT   &kp EXCL  &kp AT     &kp HASH   &kp PIPE    &none   &none           &none             &none         &none         &none
                            &kp UNDER  &kp RPAR   &kp LPAR    &trans  &trans
                                       &trans     &trans      &trans
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
&none  &none  &none  &none  &none   &none     &none   &none           &none             &none         &none         &none
&none  &nlb   &n7s   &n8s   &n9s    &nrb      &none   &none           &none             &none         &none         &none
&none  &nsc   &n4s   &n5s   &n6s    &neq      &none   &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &none
&none  &ngr   &n1s   &n2s   &n3s    &nbs      &none   &none           &none             &none         &none         &none
                     &nms   &n0s    &nds      &trans  &trans
                            &trans  &trans    &trans
            >;
        };

        media_layer {
            label = "MEDIA";
            bindings = <
&none  &none  &none  &none   &none   &none     &none         &none             &none       &none            &none  &none
&none  &none  &none  &none   &none   &none     &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_MUTE       &none  &none
&none  &none  &none  &none   &none   &none     &kp C_VOL_DN  &kp C_VOL_UP      &none       &kp C_AL_COFFEE  &none  &none
&none  &none  &none  &none   &none   &none     &none         &none             &none       &none            &none  &kp C_SLEEP
                     &trans  &trans  &trans    &trans        &trans
                             &trans  &trans    &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&none   &none           &none             &none            &none             &none          &none            &none             &none           &none          &none        &none
&none   &none           &none             &none            &none             &none          &kp LC(Z)        &kp LS(INSERT)    &kp LC(INSERT)  &kp LC(X)      &none        &kp LC(Y)
&none   &kp LEFT_GUI    &kp LEFT_ALT      &kp LEFT_CONTROL &kp LEFT_SHIFT    &none          &none            &mmv MOVE_LEFT    &mmv MOVE_DOWN  &mmv MOVE_UP   &none        &mmv MOVE_RIGHT
 &mo SCROLL  &none        &none             &none            &none             &none          &none            &msc SCRL_LEFT    &msc SCRL_DOWN  &msc SCRL_UP   &none        &msc SCRL_RIGHT
                               &trans      &trans      &trans            &mkp RCLK         &mkp LCLK
                                           &trans      &trans            &mkp MCLK
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&none   &none           &none             &none            &none             &none          &none            &none             &none           &none          &none        &none
&none   &kp LEFT_GUI    &kp LEFT_ALT      &kp LEFT_CONTROL &kp LEFT_SHIFT    &none          &kp LC(Z)        &kp LS(INSERT)    &kp LC(INSERT)  &kp LC(X)      &none        &kp LC(Y)
&none      &none        &none             &none            &none             &none          &none            &mmv MOVE_LEFT    &mmv MOVE_DOWN  &mmv MOVE_UP   &none        &mmv MOVE_RIGHT
/* SCROLL is momentary via left outer key in BASE/MOUSE (&mo SCROLL). */
&none   &none           &none             &none            &none             &none          &none            &msc SCRL_LEFT    &msc SCRL_DOWN  &msc SCRL_UP   &none        &msc SCRL_RIGHT
                               &trans      &trans      &trans            &mkp RCLK         &mkp LCLK
                                           &trans      &trans            &mkp MCLK
            >;
        };

        fun_layer {
            label = "FUN";
            bindings = <
&none  &none    &none   &none    &none      &none              &none   &none           &none             &none         &none         &none
&none  &kp F12  &kp F7  &kp F8   &kp F9     &kp PRINTSCREEN    &none   &none           &none             &none         &none         &none
&none  &kp F11  &kp F4  &kp F5   &kp F6     &kp SCROLLLOCK     &none   &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &none
&none  &kp F10  &kp F1  &kp F2   &kp F3     &kp PAUSE_BREAK    &none   &none           &none             &none         &none         &none
                        &kp TAB  &kp SPACE  &kp K_APP          &trans  &trans
                                 &trans     &trans             &trans
            >;
        };

        uml_layer {
            label = "UML";
            bindings = <
&trans  &trans  &trans           &trans            &trans           &trans    &trans  &trans  &trans  &trans  &trans     &trans
&trans  &trans  &trans           &kp DE_O_UMLAUT   &kp DE_U_UMLAUT  &trans    &trans  &trans  &trans  &trans  &trans     &trans
&trans  &trans  &kp DE_A_UMLAUT  &trans            &trans           &trans    &trans  &trans  &trans  &trans  &kp MINUS  &trans
&trans  &trans  &trans           &kp SINGLE_QUOTE  &kp GRAVE        &trans    &trans  &trans  &trans  &trans  &trans     &trans
                                 &kp TILDE         &trans           &trans    &trans  &trans
                                                   &trans           &trans    &trans
            >;
        };
    };
};
