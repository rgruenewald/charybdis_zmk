#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE    0
#define NAV     1
#define SYM     2
#define NUM     3
#define MEDIA   4
#define MOUSE   5
#define SCROLL  6
#define FUN     7

/ {
    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <BASE NAV NUM MEDIA MOUSE>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <2>;
    };

    trackball_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <SCROLL>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_HWHEEL>;
        y-input-code = <INPUT_REL_WHEEL>;
        y-invert;
        bindings = <&ib_wheel_scaler 1 14>;
    };

    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };

    combos {
        compatible = "zmk,combos";

        combo_ae {
            timeout-ms = <30>;
            bindings = <&kp A>;
            key-positions = <14 15>; /* a + e */
        };

        combo_oe {
            timeout-ms = <30>;
            bindings = <&kp O>;
            key-positions = <3 15>; /* o + e */
        };

        combo_ue {
            timeout-ms = <30>;
            bindings = <&kp U>;
            key-positions = <4 15>; /* u + e */
        };

        combo_sz {
            timeout-ms = <30>;
            bindings = <&kp S>;
            key-positions = <21 22>; /* n + s */
        };
    };

    behaviors {
        hm_l: hm_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <170>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52 54 55>;
            hold-trigger-on-release;
        };

        hm_r: hm_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <170>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 53>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp N1            &kp N2          &kp N3            &kp N4            &kp N5              &kp N6                      &kp N7          &kp N8             &kp N9             &kp N0               &kp MINUS              &kp PLUS
&kp ESCAPE        &kp Q           &kp K             &kp O             &kp U               &kp Y                       &kp V           &kp D              &kp C              &kp L                &kp F                  &kp J
&tog 6            &kp H           &hm_l LEFT_GUI A  &hm_l LEFT_ALT E  &hm_l LEFT_SHIFT I  &hm_l LEFT_CONTROL COMMA    &kp G           &hm_r RIGHT_GUI T  &hm_r RIGHT_ALT R  &hm_r RIGHT_SHIFT N  &hm_r RIGHT_CONTROL S  &none
&kp C_AC_REFRESH  &kp LEFT_SHIFT  &kp Z             &kp APOSTROPHE    &kp DOT             &kp X                       &kp B           &kp P              &kp M              &kp W                &kp RIGHT_SHIFT        &none
                                                    &lt MEDIA ESCAPE  &lt NAV SPACE       &lt MOUSE TAB               &lt NUM DELETE  &lt SYM BACKSPACE
                                                                      &mkp LCLK           &mkp RCLK                   &lt FUN ENTER
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            label = "NAV";
            bindings = <
&none  &none         &none         &none             &none           &none     &none         &none           &none           &none         &none            &none
&none  &none         &none         &none             &none           &none     &kp LC(Y)     &kp LC(V)       &kp LC(C)       &kp LC(X)     &kp LC(Z)        &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none     &kp CAPSLOCK  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&none  &none         &none         &none             &none           &none     &kp INSERT    &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &none
                                   &trans            &trans          &trans    &trans        &trans
                                                     &trans          &trans    &trans
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
&none  &none      &none     &none      &none      &none      &none  &none          &none            &none        &none       &none
&none  &kp LBRC   &kp AMPS  &kp STAR   &kp LPAR   &kp RBRC    &none  &none          &none            &none        &none       &none
&none  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS    &none  &kp LEFT_SHIFT &kp LEFT_CONTROL &kp LEFT_ALT &kp LEFT_GUI &none
&none  &kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE    &none  &none          &none            &none        &none       &none
                           &kp LPAR    &kp RPAR    &kp UNDER   &trans &trans
                                      &trans      &trans      &trans
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
&none  &none      &none      &none      &none      &none       &none  &none          &none            &none        &none       &none
&none  &kp LBKT   &kp N7     &kp N8     &kp N9     &kp RBKT    &none  &none          &none            &none        &none       &none
&none  &kp SEMI   &kp N4     &kp N5     &kp N6     &kp EQUAL   &none  &kp LEFT_SHIFT &kp LEFT_CONTROL &kp LEFT_ALT &kp LEFT_GUI &kp RIGHT_SHIFT
&none  &kp GRAVE  &kp N1     &kp N2     &kp N3     &kp BSLH    &none  &none          &none            &none        &none       &none
                               &kp DOT   &kp N0     &kp MINUS   &trans &trans
                                         &trans      &trans      &trans
            >;
        };

        media_layer {
            label = "MEDIA";
            bindings = <
&none  &none  &none  &none   &none   &none     &none         &none             &none        &none            &none  &none
&none  &none  &none  &none   &none   &none     &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT   &kp C_MUTE       &none  &none
&none  &none  &none  &none   &none   &none     &kp C_VOL_DN  &kp C_VOL_UP      &kp C_SLEEP  &kp C_AL_COFFEE  &none  &none
&none  &none  &none  &none   &none   &none     &none         &none             &none        &none            &none  &none
                     &trans  &trans  &trans    &trans        &trans
                             &trans  &trans    &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&none  &none         &none         &none             &none           &none    &none      &none           &none           &none         &none            &none
&none  &none         &none         &none             &none           &none    &kp LC(Y)  &kp LC(V)       &kp LC(C)       &kp LC(X)     &kp LC(Z)        &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none    &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&none  &none         &none         &none             &none           &none    &none      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
                                   &none             &none           &none    &none      &none
                                                     &none           &none    &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&none  &none         &none         &none             &none           &none    &none        &none           &none           &none         &none  &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none    &none        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &none  &mmv MOVE_RIGHT
&none  &none         &none         &none             &none           &none    &tog SCROLL  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &none  &msc SCRL_RIGHT
&none  &none         &none         &none             &none           &none    &kp LC(Y)    &kp LC(V)       &kp LC(C)       &kp LC(X)     &none  &kp LC(Z)
                                   &none             &none           &none    &none        &none
                                                     &none           &none    &none
            >;
        };

        fun_layer {
            label = "FUN";
            bindings = <
&none    &none    &none   &none   &none            &none            &none  &none           &none             &none         &none         &none
&none    &kp F12  &kp F7  &kp F8  &kp F9           &kp PRINTSCREEN  &none  &none           &none             &none         &none         &none
&none    &kp F11  &kp F4  &kp F5  &kp F6           &kp SCROLLLOCK   &none  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &none
&none    &kp F10  &kp F1  &kp F2  &kp F3           &kp PAUSE_BREAK  &none  &none           &none             &none         &none         &none
                         &trans  &trans           &trans            &trans  &trans
                                 &trans           &trans            &trans
            >;
        };
    };
};
