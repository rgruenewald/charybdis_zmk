#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// / {
//     chosen { zmk,matrix_transform = &default_transform; };
// };

/ {
    /* input config for mouse move mode */

    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <0>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <2>;

        // bindings = <&ib_toggle_layer 7>;
    };

    /* input config for snipe mode */

    trackball_snipe_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <3>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <4>;
    };

    /* input config for mouse scroll mode */

    trackball_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <2>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_HWHEEL>;
        y-input-code = <INPUT_REL_WHEEL>;
        y-invert;
        bindings = <&ib_wheel_scaler 1 14>;
    };

    /* define a resolution down scaler only for INPUT_REL_WHEEL */

    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };

    /* adjust cooldown waiting period for mouse key layer after activated */

    ib_toggle_layer: ib_toggle_layer {
        compatible = "zmk,input-behavior-tog-layer";
        #binding-cells = <1>;
        time-to-live-ms = <750>;
    };

    // #define BASE      0
    // #define NAV_EDIT  1
    // #define SCROLL    2
    // #define SNIPER    3
    // #define NUM_SYM   4
    // #define SHORTCUTS 5
    // #define SYSTEM    6

    combos {
        compatible = "zmk,combos";

        CAPZ {
            bindings = <&kp CAPSLOCK>;
            key-positions = <12 13>;
        };

        CAPZ_WORD {
            bindings = <&caps_word>;
            key-positions = <16 19>;
        };
    };

    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41 36 37 38>;
            hold-trigger-on-release;
        };

        ish: ish {
            compatible = "zmk,behavior-hold-tap";
            label = "INTEL_SHIFT";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
        };

        sym_l3: sym_l3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N3>, <&kp HASH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sym_l4: sym_l4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DLLR>, <&kp DLLR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sym_l5: sym_l5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp HASH>, <&kp PRCNT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sym_l6: sym_l6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp Y>, <&none>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sym_r2: sym_r2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LT>, <&kp AMPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sym_r3: sym_r3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp GT>, <&kp STAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sym_r1: sym_r1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp CARET>, <&kp CARET>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sym_r4: sym_r4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp TILDE>, <&kp TILDE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sym_r5: sym_r5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&kp UNDER>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sym_r6: sym_r6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp ESCAPE                  &kp N1                      &kp N2          &kp N3                   &kp N4                &kp N5         &kp N6         &kp N7         &kp N8               &kp N9           &kp N0          &kp MINUS
&kp ESCAPE                  &kp Q                       &kp K           &kp O                    &kp U                 &kp Y          &kp V          &kp D          &kp C                &kp L            &kp F           &kp J
&sl 4                       &kp H                       &kp A           &kp E                    &kp I                 &kp COMMA      &kp G          &kp T          &kp R                &kp N            &kp S           &sl 4
&ish LEFT_SHIFT LEFT_SHIFT  &ish LEFT_SHIFT LEFT_SHIFT  &mt LEFT_GUI Z  &mt LEFT_ALT APOSTROPHE  &mt LEFT_CONTROL DOT  &kp X          &none          &kp B          &mt RIGHT_CONTROL P  &mt RIGHT_ALT M  &mt LEFT_GUI W  &ish LEFT_SHIFT LEFT_SHIFT
                                                                        &kp LEFT_CONTROL         &kp LEFT_ALT          &lt 1 SPACE    &kp RIGHT_ALT  &kp BACKSPACE
                                                                                                 &mkp MB1              &mkp MB2       &kp ENTER
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_edit_layer {
            label = "NAV_EDIT";
            bindings = <
&kp F1     &kp F2         &kp F3     &kp F4       &kp F5              &kp F6                 &kp F7           &kp F8              &kp F9        &kp F10              &kp F11             &kp F12
&kp LC(Y)  &kp LC(F)      &kp LC(W)  &kp LC(T)    &kp LC(LS(TAB))     &kp LC(TAB)            &kp K_APP        &kp PAGE_DOWN       &kp ENTER     &kp INSERT           &kp PAGE_UP         &trans
&kp LC(Z)  &kp LG(LS(F))  &kp LC(C)  &kp LA(TAB)  &kp LC(V)           &kp LC(X)              &kp LEFT_ARROW   &kp DOWN_ARROW      &kp UP_ARROW  &kp RIGHT_ARROW      &kp BACKSPACE       &kp LC(BACKSPACE)
&trans     &trans         &kp LC(A)  &kp TAB      &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)    &kp HOME         &kp LC(LEFT_ARROW)  &kp DELETE    &kp LC(RIGHT_ARROW)  &mt LEFT_SHIFT END  &trans
                                     &trans       &kp ESCAPE          &trans                 &trans           &trans
                                                  &trans              &trans                 &kp PRINTSCREEN
            >;
        };

        scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;

            label = "SCROLL";
        };

        sniper_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;

            label = "SNIPER";
        };

        num_sym_layer {
            label = "SYMBOL";
            bindings = <
&kp N1     &kp N2     &sym_l3   &sym_l4    &sym_l5    &sym_l6       &sym_r1         &sym_r2    &sym_r3    &sym_r4    &sym_r5    &sym_r6
&none      &caps_word &kp AT    &kp O      &kp M      &kp O         &kp BSLH        &kp LBKT   &kp RBKT   &kp APOSTROPHE  &kp GRAVE  &kp C
&none      &kp E      &kp I     &kp A      &kp U      &kp S         &kp FSLH        &kp LPAR   &kp RPAR   &kp EQUAL  &kp MINUS  &kp STAR
&trans                      &trans                      &none     &kp LBRC   &kp RBRC   &none         &kp PIPE        &kp EXCL   &kp QMARK  &kp PLUS   &kp UNDER  &trans
                                &none      &kp SPACE  &none        &none           &none
                                           &none      &none        &none
            >;
        };

        shortcuts_layer {
            label = "SHORTCUTS";
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
&trans  &kp LC(Q)  &kp LC(K)  &kp LC(O)  &kp LC(U)  &kp LC(Y)    &kp LC(V)  &kp LC(D)  &kp LC(C)  &kp LC(L)  &kp LC(F)  &kp LC(J)
&trans  &kp LC(H)  &kp LC(A)  &kp LC(E)  &kp LC(I)  &trans       &kp LC(G)  &kp LC(T)  &kp LC(R)  &kp LC(N)  &kp LC(S)  &trans
&trans  &trans     &trans     &trans     &kp LC(Z)  &trans       &trans     &kp LC(X)  &kp LC(B)  &kp LC(P)  &kp LC(M)  &kp LC(W)
                              &trans     &kp ENTER  &trans       &trans     &trans
                                         &trans     &trans       &trans
            >;
        };

        system_layer {
            label = "SYSTEM";
            bindings = <
&trans      &trans        &trans           &trans        &trans        &trans               &trans      &trans            &trans      &trans        &trans        &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4         &trans      &trans            &trans      &trans        &trans        &trans
&trans      &kp C_SLEEP   &kp C_AL_COFFEE  &soft_off     &bootloader   &ext_power EP_TOG    &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE
&trans      &trans        &trans           &trans        &trans        &trans               &trans      &trans            &trans      &trans        &trans        &trans
                                           &trans        &trans        &trans               &trans      &trans
                                                         &trans        &trans               &trans
            >;
        };
    };
};
