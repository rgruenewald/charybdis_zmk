#include "keys_de_german.h"
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define SYM   2
#define NUM   3
#define MEDIA 4

/ {
    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <0>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <2>;
    };

    trackball_snipe_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <NUM>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <4>;
    };

    trackball_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <SYM>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_HWHEEL>;
        y-input-code = <INPUT_REL_WHEEL>;
        y-invert;
        bindings = <&ib_wheel_scaler 1 14>;
    };

    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };

    combos {
        compatible = "zmk,combos";

        combo_ae {
            timeout-ms = <30>;
            bindings = <&kp DE_A_UMLAUT>;
            key-positions = <20 21>; /* a + e */
        };

        combo_oe {
            timeout-ms = <30>;
            bindings = <&kp DE_O_UMLAUT>;
            key-positions = <8 9>; /* o + u */
        };

        combo_ue {
            timeout-ms = <30>;
            bindings = <&kp DE_U_UMLAUT>;
            key-positions = <9 21>; /* u + e */
        };

        combo_sz {
            timeout-ms = <30>;
            bindings = <&kp DE_SHARP_S>;
            key-positions = <16 17>; /* s + g */
        };
    };

    behaviors {
        hm_l: hm_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <170>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52 54 55>;
            hold-trigger-on-release;
        };

        hm_r: hm_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <170>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 53>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp ESCAPE    &kp B                 &kp L                 &kp D                 &kp W                 &kp Z                  &kp J                &kp F                 &kp O                 &kp U                 &kp P                &kp BACKSPACE
&trans        &hm_l LEFT_GUI N      &hm_l LEFT_ALT R      &hm_l LEFT_SHIFT T    &hm_l LEFT_CONTROL S  &kp G                  &kp Y                &hm_r RIGHT_CONTROL H &hm_r RIGHT_SHIFT A   &hm_r RIGHT_ALT E     &hm_r RIGHT_GUI I    &trans
&trans        &kp Q                 &kp X                 &kp M                 &kp C                 &kp V                  &kp K                &kp DE_COMMA          &kp DE_DOT            &kp DE_SLASH          &kp DE_MINUS         &trans
&trans        &trans                &trans                &trans                &trans                &trans                 &trans               &trans                &trans                &trans                &trans               &trans
                                          &kp ESCAPE            &sl NAV               &kp SPACE              &sl SYM                &kp BACKSPACE
                                                                 &sl NUM              &sl MEDIA              &kp ENTER
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            label = "NAV";
            bindings = <
&trans        &none                 &none                 &none                 &none                 &none                  &kp PAGE_UP          &kp HOME              &kp UP                &kp END               &kp DELETE           &trans
&trans        &kp LEFT_GUI          &kp LEFT_ALT          &kp LEFT_SHIFT        &kp LEFT_CONTROL      &none                  &kp LEFT_ARROW       &kp DOWN_ARROW        &kp RIGHT_ARROW       &kp PAGE_DOWN         &kp INSERT           &trans
&trans        &kp LC(Z)             &kp LC(X)             &kp LC(C)             &kp LC(V)             &kp LC(Y)              &kp HOME             &kp PAGE_DOWN         &kp PAGE_UP           &kp END               &kp TAB              &trans
&trans        &trans                &trans                &trans                &trans                &trans                 &trans               &trans                &trans                &trans                &trans               &trans
                                          &none                 &trans                &trans                 &trans                 &trans
                                                                 &trans               &trans                 &trans
            >;
        };

        sym_layer {
            label = "SYMBOLS";
            bindings = <
&trans        &kp DE_EXCLAMATION    &kp DE_AT_SIGN        &kp DE_HASH           &kp DE_DOLLAR         &kp DE_PERCENT         &kp DE_CARET         &kp DE_AMPERSAND      &kp DE_ASTERISK       &kp DE_LEFT_PARENTHESIS &kp DE_RIGHT_PARENTHESIS &trans
&trans        &sk LEFT_SHIFT        &kp DE_LEFT_BRACE     &kp DE_RIGHT_BRACE    &kp DE_LEFT_BRACKET   &kp DE_RIGHT_BRACKET   &kp DE_LESS_THAN     &kp DE_GREATER_THAN   &kp DE_EQUAL          &kp DE_PLUS           &kp DE_MINUS         &trans
&trans        &sk RIGHT_ALT         &kp DE_SLASH          &kp DE_TILDE          &kp DE_UNDERSCORE     &kp DE_GRAVE           &kp DE_SEMICOLON     &kp DE_COLON          &kp DE_APOSTROPHE     &kp DE_DOUBLE_QUOTES  &kp DE_QUESTION      &trans
&trans        &trans                &trans                &trans                &trans                &trans                 &trans               &trans                &trans                &trans                &trans               &trans
                                          &none                 &trans                &trans                 &trans                 &trans
                                                                 &trans               &trans                 &trans
            >;
        };

        num_layer {
            label = "NUMBERS";
            bindings = <
&trans        &kp DE_N1             &kp DE_N2             &kp DE_N3             &kp DE_N4             &kp DE_N5              &kp DE_N6            &kp DE_N7             &kp DE_N8             &kp DE_N9             &kp DE_N0            &trans
&trans        &kp LEFT_GUI          &kp LEFT_ALT          &kp LEFT_SHIFT        &kp LEFT_CONTROL      &none                  &kp F6               &kp F7                &kp F8                &kp F9                &kp F10              &trans
&trans        &kp F1                &kp F2                &kp F3                &kp F4                &kp F5                 &kp F11              &kp F12               &kp DE_COMMA          &kp DE_DOT            &kp DE_MINUS         &trans
&trans        &trans                &trans                &trans                &trans                &trans                 &kp KP_N4            &kp KP_N5             &kp KP_N6             &kp KP_MULTIPLY       &kp KP_DIVIDE        &trans
                                          &none                 &trans                &trans                 &trans                 &trans
                                                                 &kp KP_N1            &kp KP_N2              &kp KP_N3
            >;
        };

        media_layer {
            label = "MEDIA";
            bindings = <
&trans        &trans                &trans                &trans                &trans                &trans                 &trans               &trans                &trans                &trans                &trans               &trans
&trans        &trans                &trans                &trans                &trans                &trans                 &kp C_PREV           &kp C_PLAY_PAUSE      &kp C_NEXT            &kp C_MUTE            &trans               &trans
&trans        &trans                &trans                &trans                &trans                &trans                 &kp C_VOL_DN         &kp C_VOL_UP          &kp C_SLEEP           &kp C_AL_COFFEE       &trans               &trans
&trans        &trans                &trans                &trans                &trans                &trans                 &trans               &trans                &trans                &trans                &trans               &trans
                                          &none                 &trans                &trans                 &trans                 &trans
                                                                 &trans               &trans                 &trans
            >;
        };
    };
};
