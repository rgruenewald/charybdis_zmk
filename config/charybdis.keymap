#include "keys_de_swiss.h"
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// / {
//     chosen { zmk,matrix_transform = &default_transform; };
// };

/ {
    /* input config for mouse move mode */

    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <0>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <2>;

        // bindings = <&ib_toggle_layer 7>;
    };

    /* input config for snipe mode */

    trackball_snipe_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <4>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <4>;
    };

    /* input config for mouse scroll mode */

    trackball_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <3>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_HWHEEL>;
        y-input-code = <INPUT_REL_WHEEL>;
        y-invert;
        bindings = <&ib_wheel_scaler 1 14>;
    };

    /* define a resolution down scaler only for INPUT_REL_WHEEL */

    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };

    /* adjust cooldown waiting period for mouse key layer after activated */

    ib_toggle_layer: ib_toggle_layer {
        compatible = "zmk,input-behavior-tog-layer";
        #binding-cells = <1>;
        time-to-live-ms = <750>;
    };

    // #define BASE      0
    // #define SYMNUM    1
    // #define NAVSYS    2
    // #define SCROLL    3
    // #define SNIPER    4
    // #define FNBT      5

    combos {
        compatible = "zmk,combos";

        CAPZ {
            bindings = <&kp CAPSLOCK>;
            key-positions = <12 13>;
        };

        CAPZ_WORD {
            bindings = <&caps_word>;
            key-positions = <16 19>;
        };

        to_FNBT {
            bindings = <&to 5>;
            key-positions = <30 29>;
        };

        left_hand_left_click {
            bindings = <&mkp LCLK>;
            key-positions = <28 27>;
        };

        left_hand_right_click {
            bindings = <&mkp RCLK>;
            key-positions = <27 26>;
        };

        left_hand_middle_click {
            bindings = <&mkp MCLK>;
            key-positions = <27 26 28>;
        };

        right_hand_left_click {
            bindings = <&mkp LCLK>;
            key-positions = <31 32>;
        };

        right_hand_right_click {
            bindings = <&mkp RCLK>;
            key-positions = <32 33>;
        };

        right_hand_middle_click {
            bindings = <&mkp MCLK>;
            key-positions = <31 32 33>;
        };
    };

    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41 36 37 38>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp ESCAPE        &kp N1               &kp N2           &kp N3           &kp N4             &kp N5       &kp N6     &kp N7              &kp N8           &kp N9            &kp N0                &kp DE_SQT
&kp TAB           &lt 4 Q              &kp W            &kp F            &kp P              &kp B        &kp J      &kp L               &kp U            &kp Z             &kp DE_O_UMLAUT       &kp DE_U_UMLAUT
&kp LEFT_SHIFT    &hml LEFT_CONTROL A  &hml LEFT_ALT R  &hml LEFT_GUI S  &hml LEFT_SHIFT T  &kp G        &kp M      &hmr RIGHT_SHIFT N  &hmr LEFT_GUI E  &hmr RIGHT_ALT I  &hmr RIGHT_CONTROL O  &kp DE_A_UMLAUT
&kp LEFT_CONTROL  &lt 3 X              &kp C            &kp D            &kp V              &kp Y        &kp K      &kp H               &kp DE_COMMA     &kp DE_DOT        &lt 3 DE_MINUS        &trans
                                                        &lt 1 LEFT_GUI   &kp SPACE          &lt 2 TAB    &mo 1      &kp BACKSPACE
                                                                         &mkp MB1           &mkp MB2     &kp ENTER
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symnum_layer {
            label = "SYMNUM";
            bindings = <
&trans  &hml CARET DE_DEGREE  &kp DE_SECTION                   &hml DOLLAR DE_EURO        &kp AMPS                       &kp DE_PERCENT      &trans        &trans        &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS  &trans
&trans  &hml DE_GRAVE GRAVE   &kp EXCL                         &kp LEFT_BRACKET           &kp RIGHT_BRACKET              &kp PLUS            &trans        &kp N7        &kp N8         &kp N9           &kp KP_PLUS   &trans
&trans  &kp PIPE              &hml SINGLE_QUOTE DOUBLE_QUOTES  &hml LESS_THAN LEFT_BRACE  &hml GREATER_THAN RIGHT_BRACE  &kp MINUS           &kp QUESTION  &kp NUMBER_4  &kp NUMBER_5   &kp N6           &kp KP_ENTER  &trans
&trans  &hml HASH ASTRK       &hml BACKSLASH SLASH             &kp LEFT_PARENTHESIS       &kp RIGHT_PARENTHESIS          &hml EQUAL UNDER    &kp N0        &kp N1        &kp NUMBER_2   &kp NUMBER_3     &trans        &trans
                                                               &trans                     &trans                         &trans              &trans        &trans
                                                                                          &trans                         &trans              &trans
            >;
        };

        navsys_layer {
            label = "NAVSYS";
            bindings = <
&kp F1  &kp F2        &kp F3      &kp F4            &kp F5      &kp F6             &kp F7    &kp F8          &kp F9          &kp F10          &kp F11  &kp F12
&trans  &trans        &trans      &trans            &trans      &trans             &trans    &kp PAGE_UP     &kp UP_ARROW    &trans           &trans   &trans
&trans  &kp C_VOL_DN  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_VOL_UP       &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END  &kp INSERT
&trans  &trans        &trans      &trans            &trans      &kp PRINTSCREEN    &trans    &kp PAGE_DOWN   &trans          &trans           &trans   &trans
                                  &trans            &trans      &trans             &trans    &trans
                                                    &trans      &trans             &trans
            >;
        };

        scroll_layer {
            bindings = <
&trans  &trans          &trans            &trans        &trans        &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &kp C_PREV      &kp C_PLAY_PAUSE  &kp C_NEXT    &trans        &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans          &trans            &trans        &trans        &trans    &trans     &trans     &trans  &trans  &trans  &trans
                                          &trans        &trans        &trans    &mkp RCLK  &mkp LCLK
                                                        &trans        &trans    &trans
            >;

            label = "SCROLL";
        };

        sniper_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;

            label = "SNIPER";
        };

        fnbt_layer {
            bindings = <
&ext_power EP_TOG  &trans        &trans        &trans        &trans        &trans          &rgb_ug RGB_TOG  &trans           &trans           &trans           &trans           &trans
&bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans           &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &rgb_ug RGB_SPI
&trans             &trans        &trans        &trans        &trans        &trans          &trans           &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_EFR  &rgb_ug RGB_SPD
&trans             &trans        &trans        &trans        &trans        &trans          &trans           &trans           &trans           &trans           &trans           &trans
                                               &trans        &trans        &trans          &trans           &trans
                                                             &trans        &trans          &trans
            >;

            label = "FNBT";
        };
    };
};
