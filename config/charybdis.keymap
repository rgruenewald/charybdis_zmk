#include "keys_de_german.h"
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE    0
#define NAV     1
#define SYM     2
#define NUM     3
#define MEDIA   4
#define MOUSE   5
#define SCROLL  6
#define FUN     7

/ {
    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <BASE NAV NUM MEDIA MOUSE>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <2>;
    };

    trackball_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <SCROLL>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_HWHEEL>;
        y-input-code = <INPUT_REL_WHEEL>;
        y-invert;
        bindings = <&ib_wheel_scaler 1 14>;
    };

    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };

    combos {
        compatible = "zmk,combos";

        combo_ae {
            timeout-ms = <30>;
            bindings = <&kp DE_A_UMLAUT>;
            key-positions = <14 15>; /* a + e */
        };

        combo_oe {
            timeout-ms = <30>;
            bindings = <&kp DE_O_UMLAUT>;
            key-positions = <3 15>; /* o + e */
        };

        combo_ue {
            timeout-ms = <30>;
            bindings = <&kp DE_U_UMLAUT>;
            key-positions = <4 15>; /* u + e */
        };

        combo_sz {
            timeout-ms = <30>;
            bindings = <&kp DE_SHARP_S>;
            key-positions = <21 22>; /* n + s */
        };
    };

    behaviors {
        hm_l: hm_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <170>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52 54 55>;
            hold-trigger-on-release;
        };

        hm_r: hm_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <170>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 53>;
            hold-trigger-on-release;
        };

        n7s: n7s { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_N7>, <&kp DE_AMPERSAND>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        n8s: n8s { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_N8>, <&kp DE_ASTERISK>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        n9s: n9s { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_N9>, <&kp DE_LEFT_PARENTHESIS>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        n4s: n4s { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_N4>, <&kp DE_DOLLAR>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        n5s: n5s { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_N5>, <&kp DE_PERCENT>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        n6s: n6s { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_N6>, <&kp DE_CARET>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        n1s: n1s { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_N1>, <&kp DE_EXCLAMATION>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        n2s: n2s { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_N2>, <&kp DE_AT_SIGN>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        n3s: n3s { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_N3>, <&kp DE_HASH>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        n0s: n0s { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_N0>, <&kp DE_RIGHT_PARENTHESIS>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        nds: nds { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_DOT>, <&kp DE_GREATER_THAN>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        nms: nms { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_MINUS>, <&kp DE_UNDERSCORE>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        nlb: nlb { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_LEFT_BRACKET>, <&kp DE_LEFT_BRACE>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        nsc: nsc { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_SEMICOLON>, <&kp DE_COLON>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        ngr: ngr { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_GRAVE>, <&kp DE_TILDE>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        nrb: nrb { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_RIGHT_BRACKET>, <&kp DE_RIGHT_BRACE>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        neq: neq { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_EQUAL>, <&kp DE_PLUS>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        nbs: nbs { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DE_BACKSLASH>, <&kp DE_PIPE>; mods = <(MOD_LSFT|MOD_RSFT)>; };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp DE_N1        &kp DE_N2         &kp DE_N3              &kp DE_N4              &kp DE_N5              &kp DE_N6               &kp DE_N7             &kp DE_N8              &kp DE_N9              &kp DE_N0              &kp DE_MINUS                 &kp DE_PLUS
&kp ESCAPE       &kp Q             &kp K                  &kp O                  &kp U                  &kp Y                   &kp V                 &kp D                  &kp C                  &kp L                  &kp F                        &kp J
&tog SCROLL      &kp H             &hm_l LEFT_GUI A       &hm_l LEFT_ALT E       &hm_l LEFT_SHIFT I     &hm_l LEFT_CONTROL DE_COMMA   &kp G                 &hm_r RIGHT_GUI T      &hm_r RIGHT_ALT R      &hm_r RIGHT_SHIFT N    &hm_r RIGHT_CONTROL S        &none
&kp C_AC_REFRESH &kp LEFT_SHIFT    &kp Z                  &kp DE_APOSTROPHE      &kp DE_DOT             &kp X                   &kp B                 &kp P                  &kp M                  &kp W                  &kp RIGHT_SHIFT              &none
&lt MOUSE TAB      &lt NAV SPACE         &lt MEDIA ESCAPE        &lt NUM DELETE           &lt SYM BACKSPACE
                                                              &mkp LCLK             &mkp RCLK              &lt FUN ENTER
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            label = "NAV";
            bindings = <
&none   &none             &none            &none            &none                &none                  &none          &none            &none           &none            &none            &none
&none   &none             &none            &none            &none                &none                  &kp LC(Z)      &kp LC(V)        &kp LC(C)       &kp LC(X)        &kp LC(Y)        &none
&none         &kp LEFT_GUI  &kp LEFT_ALT     &kp LEFT_CONTROL &kp LEFT_SHIFT       &none                  &kp CAPSLOCK   &kp LEFT_ARROW   &kp DOWN_ARROW  &kp UP_ARROW     &kp RIGHT_ARROW  &none
&none   &none             &none            &none            &none                &none                  &kp INSERT     &kp HOME         &kp PAGE_DOWN   &kp PAGE_UP      &kp END          &none
                                  &trans            &trans           &trans               &trans           &trans
                                                     &trans           &trans           &trans
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
&none   &none               &none             &none                 &none                 &none                  &none   &none          &none            &none        &none       &none
&none   &kp DE_LEFT_BRACE   &kp DE_AMPERSAND  &kp DE_ASTERISK       &kp DE_LEFT_PARENTHESIS &kp DE_RIGHT_BRACE   &none   &none          &none            &none        &none       &none
&none   &kp DE_COLON        &kp DE_DOLLAR     &kp DE_PERCENT        &kp DE_CARET         &kp DE_PLUS            &none   &kp LEFT_SHIFT &kp LEFT_CONTROL &kp LEFT_ALT &kp LEFT_GUI &none
&none   &kp DE_TILDE        &kp DE_EXCLAMATION &kp DE_AT_SIGN       &kp DE_HASH          &kp DE_PIPE            &none   &none          &none            &none        &none       &none
                                &kp DE_UNDERSCORE        &kp DE_RIGHT_PARENTHESIS  &kp DE_LEFT_PARENTHESIS  &trans      &trans
                                                        &trans                &trans              &trans
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
&none   &none               &none        &none        &none        &none              &none   &none          &none            &none        &none       &none
&none   &nlb               &n7s         &n8s         &n9s         &nrb                 &none   &none          &none            &none        &none       &none
&none   &nsc               &n4s         &n5s         &n6s         &neq                 &none   &kp LEFT_SHIFT &kp LEFT_CONTROL &kp LEFT_ALT &kp LEFT_GUI &none
&none   &ngr               &n1s         &n2s         &n3s         &nbs                 &none   &none          &none            &none        &none       &none
                                &nms           &n0s            &nds                 &trans      &trans
                                               &trans           &trans           &trans
            >;
        };

        media_layer {
            label = "MEDIA";
            bindings = <
&none   &none  &none  &none  &none  &none   &none         &none              &none         &none             &none       &none
&none   &none  &none  &none  &none  &none   &kp C_PREV    &kp C_PLAY_PAUSE   &kp C_NEXT    &kp C_MUTE        &none       &none
&none   &none  &none  &none  &none  &none   &kp C_VOL_DN  &kp C_VOL_UP       &kp C_SLEEP   &kp C_AL_COFFEE   &none       &none
&none   &none  &none  &none  &none  &none   &none         &none              &none         &none             &none       &none
                          &trans  &trans  &trans         &trans             &trans
                                          &trans         &trans             &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&none   &none           &none             &none            &none             &none          &none            &none             &none           &none          &none        &none
&none   &none           &none             &none            &none             &none          &kp LC(Z)        &kp LC(V)         &kp LC(C)       &kp LC(X)      &none        &kp LC(Y)
&none   &kp LEFT_GUI    &kp LEFT_ALT      &kp LEFT_CONTROL &kp LEFT_SHIFT    &none          &none            &mmv MOVE_LEFT    &mmv MOVE_DOWN  &mmv MOVE_UP   &none        &mmv MOVE_RIGHT
&none   &none           &none             &none            &none             &none          &tog SCROLL      &msc SCRL_LEFT    &msc SCRL_DOWN  &msc SCRL_UP   &none        &msc SCRL_RIGHT
                               &trans      &trans      &trans            &mkp RCLK         &mkp LCLK
                                           &trans      &trans            &mkp MCLK
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&none   &none           &none             &none            &none             &none          &none            &none             &none           &none          &none        &none
&none   &kp LEFT_GUI    &kp LEFT_ALT      &kp LEFT_CONTROL &kp LEFT_SHIFT    &none          &none            &mmv MOVE_LEFT    &mmv MOVE_DOWN  &mmv MOVE_UP   &none        &mmv MOVE_RIGHT
&none   &none           &none             &none            &none             &none          &tog SCROLL      &msc SCRL_LEFT    &msc SCRL_DOWN  &msc SCRL_UP   &none        &msc SCRL_RIGHT
&none   &none           &none             &none            &none             &none          &kp LC(Z)        &kp LC(V)         &kp LC(C)       &kp LC(X)      &none        &kp LC(Y)
                               &trans      &trans      &trans            &mkp RCLK         &mkp LCLK
                                           &trans      &trans            &mkp MCLK
            >;
        };

        fun_layer {
            label = "FUN";
            bindings = <
&none        &none          &none          &none          &none             &none   &none            &none             &none           &none          &none        &none
&none        &kp F12        &kp F7         &kp F8         &kp F9            &kp PRINTSCREEN  &none            &none             &none           &none          &none        &none
&none        &kp F11        &kp F4         &kp F5         &kp F6            &kp SCROLLLOCK   &none            &kp LEFT_SHIFT    &kp LEFT_CONTROL &kp LEFT_ALT   &kp LEFT_GUI  &none
&none        &kp F10        &kp F1         &kp F2         &kp F3            &kp PAUSE_BREAK  &none            &none             &none           &none          &none        &none
                               &kp TAB     &kp SPACE     &kp K_APP         &trans            &trans
                                           &trans        &trans            &trans
            >;
        };

    };
};
